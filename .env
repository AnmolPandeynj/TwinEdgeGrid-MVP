# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://redis_broker:6379/0

# ─── Edge Node ───────────────────────────────────────────
EDGE_CPU_THRESHOLD=80
EDGE_HOST=0.0.0.0
EDGE_PORT=8000
EDGE_WS_UPDATE_HZ=2

# ─── Cloud Server / Celery ───────────────────────────────
CELERY_BROKER_URL=redis://redis_broker:6379/0
CELERY_RESULT_BACKEND=redis://redis_broker:6379/1
CELERY_WORKER_CONCURRENCY=4

# ─── FALCON SDN Meter Tables ────────────────────────────
GLOBAL_BANDWIDTH_LIMIT=1000
VIDEO_SLICE_ALLOCATION=400
VOIP_SLICE_ALLOCATION=300
DATA_SLICE_ALLOCATION=300
FALCON_REALLOC_INTERVAL_S=5
FALCON_DROP_THRESHOLD=0.1

# ─── SmartPrice Stackelberg Game ─────────────────────────
PROSUMER_COUNT=50
BASE_ENERGY_COST=0.12
SMARTPRICE_ALPHA=0.7
SMARTPRICE_DECAY_RATE=1.5

# ─── Latency Simulation (Docker tc) ─────────────────────
WAN_DELAY_MS=50
WAN_JITTER_MS=10
